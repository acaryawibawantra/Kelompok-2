{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semangatbro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "semangatbro" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskcanvas-db",
      "database_id": "b0c21a7e-3ed4-4fa5-971a-103a90ba1317",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectRoom",
        "script_name": "semangatbro-realtime"
      }
    ]
  },
  "vars": {
    "APP_URL": "https://semangatbro.exposure-backend.workers.dev",
    "REALTIME_WS_URL": "wss://semangatbro-realtime.exposure-backend.workers.dev"
  }
}
