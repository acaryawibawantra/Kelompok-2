{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "app" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semangatbro-db",
      "database_id": "2ffb3bd2-bfcb-4018-ae5a-680bfe9fd31b",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectRoom",
        "script_name": "app-realtime"
      }
    ]
  },
  "vars": {
    "APP_URL": "https://app.semangatbro.workers.dev",
    "REALTIME_WS_URL": "wss://app-realtime.semangatbro.workers.dev"
  }
}
